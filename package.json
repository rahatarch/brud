{
  "name": "brud",
  "displayName": "Brud",
  "description": "Brud: A full AI-assisted coding platform for manual paste-and-apply workflows from any AI chatbot. No API keys, no subscriptions, no setup required.",
  "publisher": "Akkhar-Labs",
  "author": "Akkhar-Labs",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahatarch/brud.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "surgical",
    "patch",
    "search",
    "replace",
    "ai",
    "orchestration",
    "brud"
  ],
  "icon": "assets/images/brud_icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "brud-sidebar",
          "title": "Brud",
          "icon": "assets/images/brud_icon.svg"
        }
      ]
    },
    "views": {
      "brud-sidebar": [
        {
          "type": "webview",
          "id": "brud-view",
          "name": "Surgical Replacer"
        }
      ]
    },
    "commands": [
      {
        "command": "brud.executePatch",
        "title": "Brud: Execute Surgical Patch",
        "category": "Brud"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "ts-loader": "^9.5.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  }
}
