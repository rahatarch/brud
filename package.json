{
  "name": "brud",
  "private": true,
  "displayName": "Brud Code",
  "description": "Brud Code: A full AI-assisted coding platform for manual paste-and-apply workflows from any AI chatbot. No API keys, no subscriptions, no setup required.",
  "publisher": "Akkhar-Labs",
  "author": "Akkhar-Labs",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahatarch/brud.git"
  },
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "apps/*"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "surgical",
    "patch",
    "search",
    "replace",
    "ai",
    "orchestration",
    "brud"
  ],
  "icon": "assets/images/brud_icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "brud-sidebar",
          "title": "Brud Code",
          "icon": "assets/images/brud_icon.svg"
        }
      ]
    },
    "views": {
      "brud-sidebar": [
        {
          "type": "webview",
          "id": "brud-view",
          "name": "Brud Code"
        }
      ]
    },
    "commands": [
      {
        "command": "brud.executePatch",
        "title": "Brud Code: Execute Surgical Patch",
        "category": "Brud Code"
      },
      {
        "command": "brud.openManagement",
        "title": "Open Brud Code Management",
        "category": "Brud Code"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack && npm run build:webview",
    "build:webview": "vite build --config packages/ui/vite.config.ts",
    "watch:webview": "vite build --config packages/ui/vite.config.ts --watch",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map && npm run build:webview",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:core": "node --import tsx --test packages/core/src/**/*.test.ts",
    "build:core": "npm run build --workspace @brud/core",
    "build:ui": "npm run build --workspace @brud/ui",
    "build:protocol": "npm run build --workspace @brud/protocol",
    "build:adapter": "npm run build --workspace @brud/vscode-adapter",
    "build:all": "npm run build:core && npm run build:protocol && npm run build:adapter && npm run build:ui"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/vscode": "^1.120.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.5.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.2",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  }
}
