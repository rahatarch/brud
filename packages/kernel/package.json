{
  "name": "@brud/kernel",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./services/*.js": {
      "types": "./dist/services/*.d.ts",
      "import": "./dist/services/*.js",
      "default": "./dist/services/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "services/WasmCage/native"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc",
    "test": "node scripts/run-tests.mjs",
    "clean": "node scripts/clean.mjs",
    "prepack": "npm run build && node scripts/verify-dist.mjs && node --import tsx scripts/repin.ts --check && node scripts/smoke-dist.mjs",
    "repin": "node --import tsx scripts/repin.ts",
    "smoke:dist": "node scripts/smoke-dist.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.x",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "description": "The BrudOS kernel: identity, giver-controlled exposures, call chains and the seven hardcore services.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahatarch/brud.git",
    "directory": "packages/kernel"
  },
  "homepage": "https://github.com/rahatarch/brud/tree/main/docs-next",
  "bugs": {
    "url": "https://github.com/rahatarch/brud/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "brud",
    "brudos",
    "kernel",
    "participants"
  ]
}
