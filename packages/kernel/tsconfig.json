{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noImplicitAny": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "src",
    "services",
    "serviceModules"
  ],
  "exclude": [
    "dist",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}