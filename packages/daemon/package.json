{
  "name": "@brud/daemon",
  "version": "0.0.2",
  "description": "Brud daemon: a neutral local host for BrudOS kernels",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "brud-daemon": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__verification__",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test \"src/__tests__/*.test.ts\""
  },
  "dependencies": {
    "@brud/kernel": "^0.0.2",
    "@brud/protocol": "^0.0.2",
    "@cotal-ai/seat": "0.160.4"
  },
  "devDependencies": {
    "@types/node": "22.x"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahatarch/brud.git",
    "directory": "packages/daemon"
  },
  "homepage": "https://github.com/rahatarch/brud/tree/main/docs-next",
  "bugs": {
    "url": "https://github.com/rahatarch/brud/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "brud",
    "brudos",
    "kernel",
    "participants"
  ]
}
