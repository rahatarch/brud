{
  "name": "@brud/service-actions",
  "version": "0.1.0",
  "description": "Brud action registry and dispatch service",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p ../../services/tsconfig.json",
    "typecheck": "tsc -p ../../services/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@brud/kernel": "*",
    "@brud/service-tools": "*",
    "@brud/service-exposed-api-registry": "*",
    "@brud/service-router": "*",
    "@brud/service-settings": "*",
    "@brud/service-validation": "*"
  },
  "devDependencies": {
    "@types/node": "22.x"
  }
}
