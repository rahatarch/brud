{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "moduleResolution": "Node16",
    "types": [
      "node"
    ]
  },
  "include": [
    "ActionManager",
    "BrandRegistry",
    "BrudFileSystem",
    "BrudTools",
    "ExposedApiRegistry",
    "Parser",
    "PluginManager",
    "Router",
    "SettingsService",
    "TerminalService",
    "UniversalHistory",
    "UtilityService",
    "ValidationService",
    "WorkspaceService"
  ],
  "exclude": [
    "dist",
    "**/dist/**",
    "**/node_modules/**",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
