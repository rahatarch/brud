{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "moduleResolution": "Node16",
    "types": [
      "node"
    ]
  },
  "include": [
    "ActionManager",
    "BrudFileSystem",
    "BrudTools",
    "SettingsService",
    "TerminalService",
    "UniversalHistory",
    "UtilityService",
    "ValidationService",
    "WorkspaceService"
  ],
  "exclude": [
    "dist",
    "**/dist/**",
    "**/node_modules/**",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
