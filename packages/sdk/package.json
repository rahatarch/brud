{
  "name": "@brud/sdk",
  "version": "0.1.0",
  "description": "The BrudOS SDK: define, compose, test and ship participants on the Brud kernel",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./participant": {
      "types": "./dist/participant/index.d.ts",
      "import": "./dist/participant/index.js",
      "default": "./dist/participant/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test __tests__/*.test.ts"
  },
  "peerDependencies": {
    "@brud/kernel": "^0.1.4"
  },
  "devDependencies": {
    "@types/node": "22.x"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahatarch/brud.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/rahatarch/brud/tree/main/docs-next",
  "bugs": {
    "url": "https://github.com/rahatarch/brud/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "brud",
    "brudos",
    "kernel",
    "participants"
  ]
}
