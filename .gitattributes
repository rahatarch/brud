# Hardcore content pins hash exact source bytes, so every checkout (Windows
# included) must keep LF line endings. Native binaries are never translated.
* text=auto eol=lf
*.node binary
*.wasm binary

# Frozen legacy fixtures record hashes over their exact LF bytes. `-text`
# disables line-ending translation so a Windows checkout keeps those bytes.
packages/kernel/services/UniversalHistory/unified/__tests__/fixtures/** -text
graphify-out/graph.json merge=graphify
